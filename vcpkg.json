{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "video-call-app",
  "version": "0.1.0",
  "description": "Production-grade low-latency video calling in C++ (custom RTP/SFU stack).",
  "dependencies": [
    "opus",
    "libsrtp",
    "libjuice",
    "spdlog",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec", "avformat", "avutil", "swscale", "x264"]
    },
    {
      "name": "gtest",
      "platform": "!uwp"
    }
  ],
  "features": {
    "signaling": {
      "description": "Standalone WebSocket signaling server.",
      "dependencies": ["uwebsockets"]
    },
    "ui": {
      "description": "Qt6 desktop client UI (heavy; off by default).",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": ["gui", "widgets", "opengl"]
        }
      ]
    }
  }
}
